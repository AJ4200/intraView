# Copy to .env.local and fill in the values.

# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=

# Groq model used for questions and scoring
GROQ_MODEL=openai/gpt-oss-20b

# Secret for recruiter endpoints (sent as the x-admin-key header). Use a long random value.
ADMIN_KEY=

# Public base URL used to build interview links and QR codes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, for when the PostgreSQL/SQLite store replaces the JSON file
# DATABASE_URL=postgres://user:pass@localhost:5432/intraview
# DATABASE_URL=file:./intraview.db
