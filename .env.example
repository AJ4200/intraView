# Copy to .env.local and fill in the values.

# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=

# Groq model used for questions and scoring
GROQ_MODEL=openai/gpt-oss-20b

# Required. Signs recruiter session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL used to build interview links, QR codes and the Google redirect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google sign-in (redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage. Leave unset to use the JSON file at .data/db.json. Or choose one:
# Neon/Vercel fallbacks: POSTGRES_URL, POSTGRES_PRISMA_URL,
# DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING (pooled URLs are preferred).
# DATABASE_URL=postgres://user:password@localhost:5432/intraview
# DATABASE_URL=file:./.data/intraview.db
